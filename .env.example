# ==============================================================================
# GYM CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and populate the values.
# NEVER commit real secret values to version control.
# Detailed instructions in docs/ENV.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL
# ------------------------------------------------------------------------------
# Base URL for public links, redirects, and webhooks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Pooled connection string (e.g. Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gym_crm?schema=public&sslmode=prefer"
# Direct connection string for Prisma migrations (optional for local, required for connection poolers)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gym_crm?schema=public&sslmode=prefer"
# Set to 1 temporarily to log each Prisma query's duration (without SQL or values).
PRISMA_QUERY_TIMING="0"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Clerk)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_ZG9jdW1lbnRlZC1leGFtcGxlLmNsZXJrLmFjY291bnRzLmRldiQ"
CLERK_SECRET_KEY="sk_test_mocksecretkeyforlocalbuildandtestingonly123456"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_placeholder_secret"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC SECRETS (Must be >= 32 characters)
# ------------------------------------------------------------------------------
# Used to sign 15-second rotating attendance QR HMAC tokens
QR_TOKEN_SECRET="generate_a_random_32_character_string_here_for_qr"
# Used to sign 30-day receipt download links sent via email
RECEIPT_LINK_SECRET="generate_a_random_32_character_string_here_for_receipts"
# Token required in Authorization header for the daily membership expiration cron
CRON_SECRET="generate_a_random_secure_cron_secret_here"

# ------------------------------------------------------------------------------
# 5. PLATFORM SUPER ADMIN BOOTSTRAP
# ------------------------------------------------------------------------------
# Comma-separated list of emails automatically assigned SUPER_ADMIN role upon first sign-in
SUPER_ADMIN_EMAILS="superadmin@gymcrm.com,owner@gymcrm.com"

# ------------------------------------------------------------------------------
# 6. REGIONAL & LOCALIZATION DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_COUNTRY_CODE="+91"

# ------------------------------------------------------------------------------
# 7. DEVELOPMENT GEOLOCATION SIMULATOR
# ------------------------------------------------------------------------------
# Dev-only preset coordinate selector on /checkin. MUST BE false in production!
ENABLE_GEO_SIMULATOR="true"
NEXT_PUBLIC_ENABLE_GEO_SIMULATOR="true"

# ------------------------------------------------------------------------------
# 8. PAYMENTS PROVIDER
# ------------------------------------------------------------------------------
# Options: demo | razorpay
PAYMENT_PROVIDER="demo"

# Razorpay credentials (Optional when PAYMENT_PROVIDER=demo)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="razorpay_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="razorpay_webhook_secret_placeholder"

# ------------------------------------------------------------------------------
# 9. EMAIL DELIVERY (Gmail SMTP / Google OAuth)
# ------------------------------------------------------------------------------
# Options: gmail-smtp | gmail-oauth
EMAIL_PROVIDER="gmail-smtp"

# Gmail SMTP Configuration (Platform Gmail Account)
# Note: GMAIL_SMTP_APP_PASSWORD requires 2-Step Verification and a 16-character Google App Password
GMAIL_SMTP_USER="platform.gymcrm@gmail.com"
GMAIL_SMTP_APP_PASSWORD="abcd efgh ijkl mnop"
EMAIL_FROM_NAME_DEFAULT="Gym CRM"

# Google OAuth Credentials (Optional: Future per-owner Gmail API integration)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
